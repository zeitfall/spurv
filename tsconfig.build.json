{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@webgpu/types"],
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "stripInternal": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/testing"]
}
