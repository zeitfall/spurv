{
  "name": "spurv",
  "version": "0.0.0",
  "private": true,
  "description": "Graphics library based on WebGPU and TypeScript.",
  "keywords": [
    "graphics-library",
    "webgpu",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "Vladyslav Matsko",
    "email": "zeitfall@icloud.com",
    "url": "https://github.com/zeitfall"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeitfall/spurv.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/library/index.d.ts",
      "default": "./dist/library/index.js"
    }
  },
  "files": [
    "dist/library"
  ],
  "sideEffects": false,
  "scripts": {
    "build:library": "tsc -p tsconfig.build.json",
    "check:types": "tsc",
    "check:imports": "node scripts/check-imports.ts",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "dev:examples": "vite",
    "build:examples": "vite build",
    "preview:examples": "vite preview"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26"
    }
  },
  "dependencies": {
    "@webgpu/types": "^0.1.74"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
